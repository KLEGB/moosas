moosas:hasFace rdfs:range moosas:Geometry ;
    rdfs:subPropertyOf bot:Element .

moosas:hasHole rdfs:range geo:Geometry ;
    rdfs:subPropertyOf moosas:Geometry .

moosas:hasLevel rdfs:range bot:Storey ;
    rdfs:subPropertyOf bot:Element .

moosas:hasNeighborElement rdfs:subClassOf bot:hasSubElement .

moosas:rawElement a moosas:surfaceType ;
    rdfs:comment "Unclassified element" .

moosas:subElementOrder rdfs:comment "the loop order of the sub elements if supported" ;
    rdfs:subPropertyOf bot:Element .

