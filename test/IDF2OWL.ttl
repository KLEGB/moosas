<April_Ground_Reflectance> idf:fieldType <real> .

<April_Ground_Temperature> idf:fieldType <real> .

<April_Surface_Ground_Temperature> idf:fieldType <real> .

<August_Deep_Ground_Temperature> idf:fieldType <real> .

<August_Ground_Reflectance> idf:fieldType <real> .

<August_Ground_Temperature> idf:fieldType <real> .

<August_Surface_Ground_Temperature> idf:fieldType <real> .

<Availability_Schedule_Name> rdfs:comment "Availability schedule name for this system. Schedule value > 0 means the system is available.If this field is blank, the system is always available." ;
    idf:fieldType <object-list> .

<Barometric_Pressure> rdfs:comment "This field's value is also checked against the calculated \"standard barometric pressure\"for the location. If out of range (>10%) or blank, then is replaced by standard value." ;
    idf:fieldType <real> .

<Beam_Solar_Day_Schedule_Name> rdfs:comment "if Solar Model Indicator = Schedule, then beam schedule name (for day)" ;
    idf:fieldType <object-list> .

