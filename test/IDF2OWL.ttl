    <July_Ground_Temperature> 2.485e+01 ;
    <June_Ground_Temperature> 2.022e+01 ;
    <March_Ground_Temperature> 1.09e+00 ;
    <May_Ground_Temperature> 1.337e+01 ;
    <November_Ground_Temperature> 1.142e+01 ;
    <October_Ground_Temperature> 1.853e+01 ;
