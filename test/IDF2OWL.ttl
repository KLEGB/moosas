    <November_Surface_Ground_Temperature> 1.4e+01 ;
    <October_Surface_Ground_Temperature> 1.4e+01 ;
    <September_Surface_Ground_Temperature> 1.4e+01 ;
    rdfs:comment "These temperatures are specifically for the Surface Ground Heat Exchanger and should probably be close to the average outdoor air temperature for the location. They are not used in other models." .

<SIZING:PARAMETERS> a idf:idfUniqueClass ;
    <Cooling_Sizing_Factor> 1.15e+00 ;
    <Heating_Sizing_Factor> 1.25e+00 ;
