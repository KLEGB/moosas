    <March_Deep_Ground_Temperature> 1.4e+01 ;
    <May_Deep_Ground_Temperature> 1.4e+01 ;
    <November_Deep_Ground_Temperature> 1.4e+01 ;
    <October_Deep_Ground_Temperature> 1.4e+01 ;
    <September_Deep_Ground_Temperature> 1.4e+01 ;
