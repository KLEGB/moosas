include LICENSE
include MoosasPy/README.md
include MoosasPy/utils/_.pth

graft MoosasPy/data
graft MoosasPy/db
graft MoosasPy/doc
graft MoosasPy/libs
graft MoosasPy/src

global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude .idea/*
prune MoosasPy/__temp__
prune MoosasPy/libs/.idea
prune MoosasPy/libs/energy/.idea
